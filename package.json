{
  "name": "mcp-git-skills-server",
  "version": "0.3.0",
  "description": "MCP server serving Git-managed business skills: SEP-2640 Skills extension + Resources/Tools triple compatibility, multi-repo aggregation, three-level progressive disclosure",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "metadata": "node dist/cli.js",
    "test": "npm run build && node --test \"test/unit/*.test.mjs\"",
    "smoke": "npm run build && node test/smoke-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
